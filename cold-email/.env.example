PORT=8787
API_KEY=change-me

# Gmail SMTP
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
EMAIL_FROM="Your Name <you@gmail.com>"

# Google Sheets (service account JSON key — share the sheet with the SA email)
GOOGLE_SERVICE_ACCOUNT_EMAIL=sheets-bot@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_ID=your-spreadsheet-id

# Paths (relative to cold-email/)
PROSPECTS_CSV=../prospects/prospects-1000.csv
CV_PATH=./assets/cv.pdf
TEMPLATE_PATH=./templates/outreach.md

# Batch behaviour
DEFAULT_BATCH_SIZE=20
MAX_BATCH_SIZE=50
SEND_CONCURRENCY=5
SEND_DELAY_MS=2000
RETRY_DELAY_MIN_MS=2000
RETRY_DELAY_MAX_MS=5000

# Set true to log + advance without sending real mail
DRY_RUN=false
